# 复制为 .env.local 后按需修改（.env.local 不提交）

# ---------- 基础 ----------
# 平台唯一入口域名（必填）。应用在 /a/{appId}/，后台在 /admin。
# 线上：apps.example.com；本地：local.example.test
APP_BASE_DOMAIN=local.example.test
PORT=3000
# 用于签名后台会话、预览票据；线上务必配置一个足够长的随机串
SECRET=change-me-to-a-long-random-string
# memory：启动内置 mongod（数据在 DATA_DIR/mongo）；线上填 mongodb://...
MONGO_URL=memory
# 不配置时使用进程内存（只适合本地单进程）；线上填 redis://...
REDIS_URL=
DATA_DIR=.data

# ---------- 应用端登录 ----------
# 不配置时默认 main-site（线上行为，复用主站 cookie）；本地开发显式设为 mock 才会模拟登录（任意手机号）
AUTH_PROVIDER=mock
# 主站用户信息接口（AUTH_PROVIDER=main-site 时必填）
AUTH_USERINFO_URL=
# 用户信息里表示用户 ID 的字段，按顺序取第一个非空值
AUTH_UID_FIELDS=uid,user_id
# 主站登录接口与移动端登录页
LOGIN_ORIGIN=
LOGIN_MOBILE_ORIGIN=
# 登录接口的 from_activity 取值（按主站要求填写）
LOGIN_FROM_ACTIVITY=
LOGIN_AGREEMENT_URL=
LOGIN_PRIVACY_URL=

# ---------- 宿主 App 容器（可选） ----------
# 格式：id:UA正则:协议[:全局变量名]，逗号分隔；协议为 android-bridge 或 call-native
# 例：panel-a:appone:android-bridge,panel-b:apptwo:call-native:apptwoBridge
APP_CONTAINERS=

# ---------- 业务接口（平台代理） ----------
# 目录/接口没有单独配上游时使用的默认地址；可以是内网服务
BIZ_API_ORIGIN=
# 上游返回这些 error_code 时视为未登录，SDK 会拉起登录并重放请求
BIZ_UNAUTH_CODES=401
# 转发到上游的超时时间（毫秒）
BIZ_TIMEOUT_MS=15000

# ---------- 后台登录 ----------
# 本地免登（线上必须关闭）
DEV_ADMIN_BYPASS=1
# make dev 就绪后自动打开浏览器；设为 1 关闭
# DEV_NO_OPEN=1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 只允许本企业登录（飞书 tenant_key）
FEISHU_TENANT_KEY=
# 平台管理员（邮箱或飞书 open_id，逗号分隔）；留空时第一个登录的人自动成为平台管理员（仅用于全新部署兜底，配了这项之后谁都不能靠抢先登录拿到管理员）
PLATFORM_ADMINS=
# 飞书群机器人（发布、审批通知）
FEISHU_BOT_WEBHOOK=

# ---------- 模型（公司 LLM 网关，OpenAI 兼容协议） ----------
# 不配置 LLM_BASE_URL 时使用内置的脚本化模型（LLM_PROVIDER=mock），可以走通界面流程
# 要带 /v1（程序会再拼 /chat/completions），例如 https://openhubs.zhidemai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELS=glm-4.6,qwen3-coder-plus,deepseek-chat,kimi-k2
LLM_DEFAULT_MODEL=glm-4.6
LLM_SMALL_MODEL=qwen-turbo
# 支持看图的模型（逗号分隔）
LLM_VISION_MODELS=
LLM_CONTEXT_TOKENS=128000
AGENT_DAILY_TOKENS_PER_USER=3000000

# 内容安全：配置后调用公司审核服务，否则按关键词拦截
MODERATION_URL=
MODERATION_BLOCKED_WORDS=

# ---------- 其他 ----------
# 发布后刷新 CDN 的回调（POST {urls: []}）
CDN_PURGE_URL=

# ---------- 安全 ----------
# CSP img-src 额外放行的图片域名（逗号分隔）
CSP_IMG_EXTRA=
# 应用代码里禁止使用的依赖（精确包名，逗号分隔）
GUARD_FORBIDDEN_PACKAGES=
# 允许应用整页跳转的主机（含子域，逗号分隔）
GUARD_ALLOWED_REDIRECT_HOSTS=
