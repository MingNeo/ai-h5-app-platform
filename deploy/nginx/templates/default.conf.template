# 由 nginx 官方镜像在启动时用 envsubst 渲染（只替换已定义的环境变量）
# APP_BASE_DOMAIN   平台唯一入口域名，例：apps.example.com
# SERVER_UPSTREAM   平台 server，例：host.docker.internal:3000 或 server:3000
# ADMIN_UPSTREAM    后台前端；本地开发指向 Vite（host.docker.internal:5173），整套容器模式指向 server:3000
#
# 只有一个域名、一个证书、一个 server 块：
#   /admin、/admin/...  后台 SPA
#   /admin-api/...      后台接口
#   /a/{appId}/...      应用
#   /__platform/...     平台运行时与 SDK
# 不需要泛域名 DNS，也不需要通配证书。

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${APP_BASE_DOMAIN};

  ssl_certificate     /etc/nginx/certs/cert.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;
  client_max_body_size 12m;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;

  location /admin-api/ {
    proxy_pass http://${SERVER_UPSTREAM};
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  # 后台静态资源：本地开发指向 Vite，整套容器模式指向 server
  location = /admin {
    return 301 /admin/;
  }

  location /admin/ {
    proxy_pass http://${ADMIN_UPSTREAM};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }

  # 应用、平台接口、SDK
  location / {
    proxy_pass http://${SERVER_UPSTREAM};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
